---
import { withBase } from '../lib/paths.mjs';
const base = import.meta.env.BASE_URL;
const current = Astro.url.pathname.replace(base.replace(/\/$/, ''), '') || '/';
const links = [{ href: '/', label: '首页' }, { href: '/#spaces', label: '六个空间' }, { href: '/cases/', label: '项目' }, { href: '/works/', label: '作品' }, { href: '/resume/', label: '简历' }];
---
<header class="site-header">
  <a class="wordmark" href={withBase('/', base)} aria-label="段骁，返回首页" data-wordmark>
    <svg width="28" height="28" viewBox="0 0 28 28" fill="none" aria-hidden="true"><path d="M3 4h10v10H3zM15 14h10v10H15z" stroke="currentColor" stroke-width="1.5"/><path d="M15 4h10M25 4v8M3 24h10M3 16v8" stroke="currentColor" stroke-width="1.5"/></svg>
    <span>段骁<span class="wordmark-en">DUAN XIAO</span></span>
  </a>
  <nav aria-label="主导航">
    {links.map(link => <a href={withBase(link.href, base)} aria-current={(link.href === '/' ? current === '/' : link.href === '/#spaces' ? current.startsWith('/spaces/') : current.startsWith(link.href)) ? 'page' : undefined}>{link.label}</a>)}
  </nav>
  <div class="header-actions">
    <button class="theme-toggle" type="button" aria-label="切换到浅色主题" title="切换明暗主题" data-theme-toggle hidden>
      <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2m0 16v2M2 12h2m16 0h2M5 5l1.4 1.4m11.2 11.2L19 19M5 19l1.4-1.4M17.6 6.4 19 5"/></svg>
    </button>
    <a class="header-download" href={withBase('/resume/?print=1', base)} title="打开打印窗口后选择另存为 PDF">下载简历 PDF</a>
    <a class="header-contact" href="#contact">联系我 <span aria-hidden="true">↗</span></a>
  </div>
  <div class="cyanotype-toast" data-cyanotype-toast aria-hidden="true" hidden><img src={withBase('/covers/cyanotype.webp', base)} alt="" width="800" height="600" /></div>
</header>
<script>
  const wordmark = document.querySelector<HTMLAnchorElement>('[data-wordmark]');
  const plateToast = document.querySelector<HTMLElement>('[data-cyanotype-toast]');
  const plateImage = plateToast?.querySelector<HTMLImageElement>('img');
  let plateTimer = 0;
  wordmark?.addEventListener('click', event => {
    let count = 0;
    const now = Date.now();
    try {
      const previous = JSON.parse(sessionStorage.getItem('dx-wordmark-taps') || '{}') as { count?: number; at?: number };
      count = previous.at && now - previous.at < 4000 ? (previous.count || 0) + 1 : 1;
      sessionStorage.setItem('dx-wordmark-taps', JSON.stringify({ count, at: now }));
    } catch { count = 1; }
    const homePath = new URL(wordmark.href).pathname;
    if (count >= 5) {
      event.preventDefault();
      try { sessionStorage.removeItem('dx-wordmark-taps'); } catch {}
      if (plateToast) {
        const crops = ['20% 20%', '80% 20%', '50% 50%', '20% 80%', '80% 80%'];
        plateImage?.style.setProperty('--plate-position', crops[Math.floor(Math.random() * crops.length)]);
        plateToast.hidden = false;
        plateToast.classList.remove('is-visible');
        requestAnimationFrame(() => plateToast.classList.add('is-visible'));
        window.clearTimeout(plateTimer);
        plateTimer = window.setTimeout(() => {
          plateToast.classList.remove('is-visible');
          window.setTimeout(() => { if (plateToast) plateToast.hidden = true; }, 260);
        }, 3000);
      }
    } else if (location.pathname === homePath) {
      event.preventDefault();
      window.scrollTo({ top: 0, behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'instant' : 'smooth' });
    }
  });
</script>
