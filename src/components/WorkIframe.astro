---
interface Props { url: string; title: string; }
const { url, title } = Astro.props;
---
<section class="preview-section" aria-label="作品预览">
  <div class="preview-top"><span>作品现场</span><a class="text-link" href={url} target="_blank" rel="noopener noreferrer">独立打开 <span aria-hidden="true">↗</span></a></div>
  <div class="preview-box" data-preview data-url={url} data-title={title}>
    <div data-preview-prompt class="preview-prompt"><span class="eyebrow">OPEN THE EXPERIMENT</span><p>准备好，进入作品。</p><button type="button" class="button" data-preview-button hidden>加载交互预览 <span aria-hidden="true">↗</span></button><noscript><a href={url} target="_blank" rel="noopener noreferrer">在新标签页打开作品</a></noscript><span class="preview-hint">预览在点击后加载。复杂交互建议独立打开。</span></div>
  </div>
  <p class="preview-status" data-preview-status role="status"></p>
</section>
<script>
  document.querySelectorAll<HTMLElement>('[data-preview]').forEach(box => {
    const button = box.querySelector<HTMLButtonElement>('[data-preview-button]');
    if (!button) return;
    button.hidden = false;
    button.addEventListener('click', () => {
      button.disabled = true; button.textContent = '正在加载…';
      const status = box.parentElement?.querySelector<HTMLElement>('[data-preview-status]');
      const frame = document.createElement('iframe');
      frame.title = box.dataset.title || '作品预览';
      frame.src = box.dataset.url || '';
      frame.setAttribute('sandbox', 'allow-scripts allow-downloads');
      frame.setAttribute('referrerpolicy', 'no-referrer');
      const timer = window.setTimeout(() => { if (status) status.textContent = '若预览未出现，请使用上方“独立打开”。'; }, 10000);
      frame.addEventListener('load', () => {
        window.clearTimeout(timer);
        box.querySelector('[data-preview-prompt]')?.remove();
        if (status) status.textContent = '作品已载入；如交互受限，可在新标签页独立打开。';
      }, { once: true });
      box.append(frame);
    }, { once: true });
  });
</script>
