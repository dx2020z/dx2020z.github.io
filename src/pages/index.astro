---
import Layout from '../layouts/Layout.astro';
import PathSelector from '../components/PathSelector.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { getCollection } from 'astro:content';
import { spaces, spacePath } from '../data/spaces';
import { site } from '../data/site';
import { withBase } from '../lib/paths.mjs';
const path = (p: string) => withBase(p, import.meta.env.BASE_URL);
const allWorks = await getCollection('works');
const projectCases = (await getCollection('cases'))
  .filter(entry => entry.data.type === 'project' && entry.data.featured)
  .sort((a, b) => a.data.order - b.data.order);
const routes = [
  { id: 'recruiter', title: '招聘方', note: '快速了解我做事的方式与证据。', steps: [
    { n: '01', title: '认识我', text: '看档案与当前开放状态。', href: spacePath('about') },
    { n: '02', title: '看能力证据', text: '从写、做、聚进入具体作品。', href: spacePath('can-do') + '#capabilities' },
    { n: '03', title: '查看简历', text: '经历、能力、代表作与教育。', href: '/resume/' },
  ] },
  { id: 'partner', title: '合作方', note: '从你要解决的问题开始。', steps: [
    { n: '01', title: '我能做什么', text: 'AI 应用、内容和社群方向。', href: spacePath('can-do') },
    { n: '02', title: '看项目案例', text: '从项目过程了解我的做事方式。', href: '#representatives' },
    { n: '03', title: '联系我', text: '带着场景一起聊下一步。', href: '#contact' },
  ] },
  { id: 'wander', title: '随便逛逛', note: '从作品或一首诗开始都可以。', steps: [
    { n: '01', title: '打开作品', text: '看工具、交互与实验。', href: '/works/' },
    { n: '02', title: '读一点文字', text: '看看我写的诗与读书笔记。', href: spacePath('life') },
    { n: '03', title: '认识这个人', text: '回到档案与六个空间。', href: '#spaces' },
  ] },
];
---
<Layout>
  <section class="hero hero-profile" aria-labelledby="hero-title">
    <div class="hero-copy">
      <span class="eyebrow hero-eyebrow"><span class="live-dot"></span> DUAN XIAO / WRITE · MAKE · GATHER</span>
      <h1 id="hero-title">把想法，<br/>做成<span class="accent">真的。</span></h1>
      <p class="hero-description">{site.positioning}</p>
      <div class="hero-actions"><a class="button primary" href="#representatives">看项目案例 <span aria-hidden="true">↗</span></a><a class="button" href="#paths">30 秒认识我 <span aria-hidden="true">↓</span></a></div>
      <p class="hero-status">开放全职机会与项目合作 <span>·</span> 深圳 / 可远程</p>
    </div>
    <aside class="profile-card" id="profile" aria-label="段骁个人档案卡">
      <div class="profile-card-top"><span>PROFILE / DX</span><span>2026</span></div>
      <div class="profile-photo-frame">
        <img class="profile-photo" src={path(site.profilePhotoColor)} alt="段骁的彩色半身照" width="1280" height="1920" fetchpriority="high" />
      </div>
      <div class="profile-name"><strong>段骁</strong><span>用 AI 写、做、聚</span></div>
      <dl class="profile-facts">
        <div><dt>状态</dt><dd>开放机会</dd></div><div><dt>城市</dt><dd>深圳</dd></div>
        <div><dt>在找</dt><dd>全职机会 / 项目合作</dd></div><div><dt>可开始时间</dt><dd>随时</dd></div>
      </dl>
      <div class="profile-tags" aria-label="能力方向"><a href={path('/spaces/can-do/#capabilities')}>AI 应用</a><a href={path('/spaces/can-do/#capabilities')}>需求梳理</a><a href={path('/spaces/can-do/#capabilities')}>内容写作</a><a href={path('/spaces/can-do/#capabilities')}>读书社群</a></div>
    </aside>
  </section>

  <section class="proof-strip" aria-label="作品与经历概览">
    <p><span>《万山无阻》联合作者</span><i aria-hidden="true">·</i><span>{allWorks.length} 件作品</span><i aria-hidden="true">·</i><span>读书社群运营</span></p>
  </section>

  <PathSelector routes={routes} />

  <section class="representative-section" id="representatives" aria-labelledby="representatives-title">
    <div class="section-heading"><div><div class="section-label"><span class="number">02 /</span> SELECTED PROJECTS</div><h2 id="representatives-title">3 个我正在用的系统</h2></div><a class="text-link" href={path('/cases/')}>查看全部项目 <span aria-hidden="true">↗</span></a></div>
    <div class="representative-grid">{projectCases.map(entry => <ProjectCard entry={entry} />)}</div>
  </section>

  <section class="chapter-index home-spaces" aria-labelledby="chapter-index-title">
    <div class="chapter-index-heading" id="spaces"><div><div class="section-label"><span class="number">03 /</span> SIX WAYS IN</div><h2 id="chapter-index-title">同一个人，<br/>从六个入口认识。</h2></div><p>从档案到生活，从能力到作品。选一条与你此刻有关的线索，走进去。</p></div>
    <div class="space-card-grid">
      {spaces.map((space, index) => <a class:list={['space-card', 'space-card-' + space.slug]} href={path(spacePath(space.slug))}><span class="space-card-top"><small>{space.level}</small><b aria-hidden="true">↗</b></span><span class="space-card-mark" aria-hidden="true">{index === 0 ? 'DX' : index === 1 ? '写' : index === 2 ? allWorks.length : index === 3 ? 'AI' : index === 4 ? '字' : '诗'}</span><strong>{space.title}</strong><span class="space-card-door">{space.door}</span></a>)}
    </div>
  </section>

  <section class="home-longread" aria-labelledby="home-longread-title"><div><div class="section-label"><span class="number">04 /</span> ONE LONG READ</div><h2 id="home-longread-title">一篇文章，<br/>继续往思想里走。</h2></div><a href={site.longArticleUrl} target="_blank" rel="noopener noreferrer"><span class="eyebrow">WECHAT OFFICIAL ACCOUNT / 公众号长文</span><strong>{site.longArticleTitle}</strong><span class="home-longread-summary">{site.longArticleSummary}</span><small>在新页面阅读原文 <span aria-hidden="true">↗</span></small></a></section>
</Layout>
