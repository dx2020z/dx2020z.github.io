---
import Layout from '../layouts/Layout.astro';
import { withBase } from '../lib/paths.mjs';
---
<Layout title="页面未找到 · 段骁"><section class="page-intro not-found"><span class="eyebrow">404 / OUTSIDE THE INDEX</span><h1>这页暂时不在这里。</h1><p>地址可能有误，或作品已经搬了位置。</p><a class="button primary" href={withBase('/works/',import.meta.env.BASE_URL)}>回到作品库 <span aria-hidden="true">↗</span></a></section></Layout>
