---
import { getCollection, render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import WorkIframe from '../../components/WorkIframe.astro';
import { kindLabels } from '../../lib/model.mjs';
import { withBase, workDestination } from '../../lib/paths.mjs';
export async function getStaticPaths() { return (await getCollection('works')).map(work => ({ params: { slug: work.data.slug }, props: { work } })); }
interface Props { work: CollectionEntry<'works'>; }
const { work } = Astro.props;
const w = work.data;
const { Content } = await render(work);
const destination = workDestination(w, import.meta.env.BASE_URL);
---
<Layout title={w.title + ' · 段骁'} description={w.desc}>
  <div class="detail-back"><a class="text-link" href={withBase('/works/', import.meta.env.BASE_URL)}><span aria-hidden="true">←</span> 全部作品</a></div>
  <header class="detail-header"><div class="detail-kicker"><span class="eyebrow">{kindLabels[w.kind]} / {w.year || 'ARCHIVE'}</span><span class:list={['status',{experimental:w.status !== '完成'}]}>{w.status}</span></div><h1>{w.title}</h1><p class="detail-desc">{w.desc}</p><div class="detail-actions"><a class="button primary" href={destination} target="_blank" rel="noopener noreferrer">{w.type === 'external' ? '打开外部作品' : w.availability === '需要环境' ? '查看原型界面' : '打开作品'} <span aria-hidden="true">↗</span></a><span>{w.credit}</span></div></header>
  {w.note && <aside class="work-notice"><span>体验说明</span><p>{w.note}</p></aside>}
  {w.cover && <figure class="detail-cover"><img src={withBase(w.cover, import.meta.env.BASE_URL)} width="1200" height="750" alt={w.title + '的实际界面截图'} /><figcaption>作品界面 / {w.title}</figcaption></figure>}
  <div class="detail-body"><aside class="detail-facts"><dl><dt>类型</dt><dd>{kindLabels[w.kind]}</dd><dt>形式</dt><dd>{w.type === 'external' ? '外部网站' : '本站 HTML 作品'}</dd><dt>关键词</dt><dd>{w.tags.filter(tag => !['Kimi','Manus'].includes(tag)).join(' / ')}</dd><dt>创作方式</dt><dd>{w.credit}</dd></dl></aside><article class="prose"><Content /></article></div>
  {w.type === 'local' && w.preview && <WorkIframe url={destination} title={w.title} />}
  {w.type === 'external' && <div class="external-footnote">此作品托管在第三方平台，将在新标签页打开。可访问性可能随原站服务变化。</div>}
</Layout>
