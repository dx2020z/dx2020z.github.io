---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import WorkGrid from '../../components/WorkGrid.astro';
const allWorks = await getCollection('works');
const orderedWorks = allWorks.sort((a,b) => a.data.order - b.data.order || a.data.title.localeCompare(b.data.title, 'zh-CN'));
const featuredCount = orderedWorks.filter(work => work.data.featured).length;
---
<Layout title="作品 · 段骁" description="段骁的 HTML 作品、工具、视觉、交互实验与文字创作。">
  <header class="page-intro"><span class="eyebrow">THE WORK INDEX / {allWorks.length} ITEMS</span><h1>想过，也做过。</h1><p>先看精选作品；展开后可以浏览全部 {allWorks.length} 件，并按类型筛选。</p></header>
  <section class="works-tier" aria-labelledby="complete-title"><header><span class="eyebrow">01 / SELECTED WORKS</span><h2 id="complete-title">精选作品 <small>{featuredCount}</small></h2><p>每件作品都保留完成状态与打开方式。</p></header><WorkGrid works={orderedWorks} /></section>
</Layout>
